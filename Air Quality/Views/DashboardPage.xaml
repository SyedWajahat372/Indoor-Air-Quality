<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="Air_Quality.Views.DashboardPage"
             Title="Air Quality Intelligence"
             BackgroundColor="#090D16">

    <Grid RowDefinitions="*">

        <RefreshView x:Name="RefreshView"
                     Refreshing="RefreshView_Refreshing"
                     RefreshColor="#00F2FE">

            <ScrollView Padding="18">
                <VerticalStackLayout Spacing="20">

                    <!-- ================= TOP HEADER BAR ================= -->
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                        
                        <!-- App Brand & Title -->
                        <HorizontalStackLayout Spacing="12" Grid.Column="0" VerticalOptions="Center">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" Padding="10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00F2FE"/>
                                        <GradientStop Color="#3B82F6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="☁" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#090D16"/>
                            </Border>
                            
                            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                <HorizontalStackLayout Spacing="2">
                                    <Label Text="Smart Air" FontSize="20" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="Quality" FontSize="20" FontAttributes="Bold" TextColor="#00F2FE" />
                                </HorizontalStackLayout>
                               
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Device Node Chip -->
                        <Border Grid.Column="2" 
                                StrokeThickness="1" 
                                Stroke="#1AFFFFFF"
                                BackgroundColor="#AA121A2B"
                                Padding="12,6"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse WidthRequest="8" HeightRequest="8" Fill="#10B981" VerticalOptions="Center"/>
                                <Label Text="IAQ Node 01 • Living Room" FontSize="12" FontAttributes="Bold" TextColor="#F1F5F9" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- ================= HERO SECTION: AI MODEL PREDICTIVE DIAGNOSTICS ================= -->
                    <Border StrokeThickness="1" 
                            Stroke="#2AA855F7"
                            Padding="24">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1AA855F7"/>
                                <GradientStop Color="#121A2B" Offset="0.6"/>
                                <GradientStop Color="#0D121F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="16" VerticalOptions="Center">
                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Spacing="10">
                                   
                                    <Label Text="Real-Time Air Quality Classification" FontSize="16" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <Border Grid.Column="1" Padding="14,6" StrokeThickness="0" BackgroundColor="#1F00F2FE">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Label x:Name="ConfidenceLabel" Text="Confidence : --%" FontSize="13" FontAttributes="Bold" TextColor="#00F2FE"/>
                                </Border>
                            </Grid>

                            <!-- Prediction Status Banner -->
                            <Border Padding="22" StrokeThickness="1" Stroke="#3010B981" BackgroundColor="#1510B981">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <Label Text="🧠" FontSize="36" VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <Label x:Name="PredictionLabel" Text="AI MODEL OFFLINE" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                                        <Label x:Name="StatusLabel" Text="Server Going Live @ 9 PM • Waiting for AI Stream" FontSize="14" TextColor="#CBD5E1"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ================= SECTION: 4 CIRCULAR MINI-GAUGES ================= -->
                    <Label Text="PRIMARY ENVIRONMENTAL GAUGES" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           CharacterSpacing="1.5" 
                           TextColor="#94A3B8" 
                           Margin="2,4,0,0"/>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                        
                        <!-- CO2 Circular Gauge -->
                        <Border Grid.Column="0" StrokeThickness="1" Stroke="#1AFFFFFF" BackgroundColor="#AA121A2B" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="CO₂ NDIR (SCD41)" FontSize="11" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                <GraphicsView x:Name="Co2GaugeView" HeightRequest="120" WidthRequest="120" HorizontalOptions="Center"/>
                                <Label x:Name="CO2Label" Text="-- ppm" FontSize="13" FontAttributes="Bold" TextColor="#10B981" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- PM2.5 Circular Gauge -->
                        <Border Grid.Column="1" StrokeThickness="1" Stroke="#1AFFFFFF" BackgroundColor="#AA121A2B" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="PM2.5 Laser (SPS30)" FontSize="11" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                <GraphicsView x:Name="Pm25GaugeView" HeightRequest="120" WidthRequest="120" HorizontalOptions="Center"/>
                                <Label x:Name="PM25Label" Text="-- µg/m³" FontSize="13" FontAttributes="Bold" TextColor="#3B82F6" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Temperature Circular Gauge -->
                        <Border Grid.Column="2" StrokeThickness="1" Stroke="#1AFFFFFF" BackgroundColor="#AA121A2B" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="Temperature" FontSize="11" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                <GraphicsView x:Name="TempGaugeView" HeightRequest="120" WidthRequest="120" HorizontalOptions="Center"/>
                                <Label x:Name="TempLabel" Text="-- °C" FontSize="13" FontAttributes="Bold" TextColor="#00F2FE" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Humidity Circular Gauge -->
                        <Border Grid.Column="3" StrokeThickness="1" Stroke="#1AFFFFFF" BackgroundColor="#AA121A2B" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="Relative Humidity" FontSize="11" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                <GraphicsView x:Name="HumidityGaugeView" HeightRequest="120" WidthRequest="120" HorizontalOptions="Center"/>
                                <Label x:Name="HumidityLabel" Text="-- %" FontSize="13" FontAttributes="Bold" TextColor="#A855F7" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- ================= SECTION: PARTICULATE & VOLATILE BREAKDOWN ================= -->
                    <Label Text="PARTICULATE FRACTIONS &amp; CHEMICAL VOLATILES" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           CharacterSpacing="1.5" 
                           TextColor="#94A3B8" 
                           Margin="2,4,0,0"/>

                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                        
                        <!-- PM1.0 -->
                        <Border Grid.Column="0" StrokeThickness="1" Stroke="#1AFFFFFF" BackgroundColor="#AA121A2B" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="PM1.0 Ultra" FontSize="10" TextColor="#94A3B8"/>
                                <Label x:Name="PM1Label" Text="-- µg/m³" FontSize="16" FontAttributes="Bold" TextColor="#00F2FE"/>
                                <ProgressBar Progress="0.15" ProgressColor="#00F2FE"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- PM4.0 -->
                        <Border Grid.Column="1" StrokeThickness="1" Stroke="#1AFFFFFF" BackgroundColor="#AA121A2B" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="PM4.0 Mid" FontSize="10" TextColor="#94A3B8"/>
                                <Label x:Name="PM4Label" Text="-- µg/m³" FontSize="16" FontAttributes="Bold" TextColor="#F59E0B"/>
                                <ProgressBar Progress="0.25" ProgressColor="#F59E0B"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- PM10 -->
                        <Border Grid.Column="2" StrokeThickness="1" Stroke="#1AFFFFFF" BackgroundColor="#AA121A2B" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="PM10 Coarse" FontSize="10" TextColor="#94A3B8"/>
                                <Label x:Name="PM10Label" Text="-- µg/m³" FontSize="16" FontAttributes="Bold" TextColor="#EC4899"/>
                                <ProgressBar Progress="0.3" ProgressColor="#EC4899"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- eCO2 -->
                        <Border Grid.Column="3" StrokeThickness="1" Stroke="#1AFFFFFF" BackgroundColor="#AA121A2B" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="eCO₂ (CCS811)" FontSize="10" TextColor="#94A3B8"/>
                                <Label x:Name="ECO2Label" Text="-- ppm" FontSize="16" FontAttributes="Bold" TextColor="#A855F7"/>
                                <ProgressBar Progress="0.4" ProgressColor="#A855F7"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- TVOC -->
                        <Border Grid.Column="4" StrokeThickness="1" Stroke="#1AFFFFFF" BackgroundColor="#AA121A2B" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="TVOC VOCs" FontSize="10" TextColor="#94A3B8"/>
                                <Label x:Name="TVOCLabel" Text="-- ppb" FontSize="16" FontAttributes="Bold" TextColor="#F59E0B"/>
                                <ProgressBar Progress="0.25" ProgressColor="#F59E0B"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- ================= SECTION: LIVE ANALYTICS CHART ================= -->
                    <Label Text="MICROCLIMATE TELEMETRY ANALYTICS" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           CharacterSpacing="1.5" 
                           TextColor="#94A3B8" 
                           Margin="2,8,0,0"/>

                    <Border StrokeThickness="1" Stroke="#1AFFFFFF" BackgroundColor="#AA121A2B" Padding="18">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24"/>
                        </Border.StrokeShape>

                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                            
                            <!-- Header & Live Tag -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Telemetry Stream History" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="Real-time IoT sensor telemetry curve" FontSize="12" TextColor="#94A3B8"/>
                                </VerticalStackLayout>

                                <Border Grid.Column="1" BackgroundColor="#1510B981" StrokeThickness="1" Stroke="#3010B981" Padding="12,6" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="6">
                                        <Ellipse WidthRequest="8" HeightRequest="8" Fill="#10B981" VerticalOptions="Center"/>
                                        <Label Text="FIREBASE LIVE" FontAttributes="Bold" FontSize="11" TextColor="#10B981" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Parameter Switcher Tab Buttons -->
                            <HorizontalStackLayout Grid.Row="1" Spacing="8">
                                <Button Text="Temperature (°C)" Clicked="OnTempChartClicked" BackgroundColor="#00F2FE" TextColor="#090D16" FontAttributes="Bold" CornerRadius="10" HeightRequest="36" FontSize="12"/>
                                <Button Text="CO₂ (ppm)" Clicked="OnCo2ChartClicked" BackgroundColor="#1AFFFFFF" TextColor="#F1F5F9" CornerRadius="10" HeightRequest="36" FontSize="12"/>
                                <Button Text="PM2.5 (µg/m³)" Clicked="OnPm25ChartClicked" BackgroundColor="#1AFFFFFF" TextColor="#F1F5F9" CornerRadius="10" HeightRequest="36" FontSize="12"/>
                                <Button Text="TVOC (ppb)" Clicked="OnTvocChartClicked" BackgroundColor="#1AFFFFFF" TextColor="#F1F5F9" CornerRadius="10" HeightRequest="36" FontSize="12"/>
                            </HorizontalStackLayout>

                            <!-- Chart Canvas -->
                            <Border Grid.Row="2" StrokeThickness="0" BackgroundColor="#0D121F" Padding="10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>

                                <lvc:CartesianChart x:Name="SensorChart" HeightRequest="220" BackgroundColor="Transparent"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ================= FOOTER ================= -->
                    <Grid ColumnDefinitions="*,Auto" Margin="4,8,4,20">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Last Firebase Synchronization" FontSize="11" TextColor="#64748B"/>
                            <Label x:Name="TimestampLabel" Text="--:--:--" FontSize="13" FontAttributes="Bold" TextColor="#F1F5F9"/>
                        </VerticalStackLayout>

                        <Border Grid.Column="1" StrokeThickness="1" Stroke="#3010B981" BackgroundColor="#1510B981" Padding="14,8" VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse WidthRequest="8" HeightRequest="8" Fill="#10B981" VerticalOptions="Center"/>
                                <Label Text="SYSTEM OPERATIONAL" FontSize="11" FontAttributes="Bold" TextColor="#10B981" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>

        </RefreshView>

    </Grid>

</ContentPage>